# ---------------------------------------------------------------------------
# ForexWatch – Konfiguration (alle Werte optional, sinnvolle Defaults gesetzt)
# Kopiere diese Datei nach .env und passe sie an.
# ---------------------------------------------------------------------------

# Datenquelle: yahoo (kein Key noetig) | twelvedata | synthetic (Offline-Demo)
FW_PROVIDER=yahoo

# Optionaler Key fuer den TwelveData-Provider (https://twelvedata.com)
FW_TWELVEDATA_KEY=

# Beobachtete Instrumente, kommagetrennt
FW_PAIRS=EURUSD,GBPUSD,USDJPY,USDCHF,AUDUSD,USDCAD,NZDUSD,EURJPY,EURGBP,GBPJPY

# Analyse-Timeframes (der erste ist der Ausfuehrungs-Timeframe)
FW_TIMEFRAMES=15m,1h,4h,1d

# Sekunden zwischen zwei Marktscans
FW_SCAN_INTERVAL=60

# Ab welchem Readiness-Score ein Setup als "scharf" (ARMED) gilt
FW_ARM_THRESHOLD=62

# Server
FW_HOST=127.0.0.1
FW_PORT=8000

# Optionale Alarm-Ausgaenge
FW_WEBHOOK_URL=
FW_TELEGRAM_TOKEN=
FW_TELEGRAM_CHAT_ID=

# Risiko-Defaults fuer den Positionsrechner
FW_ACCOUNT_BALANCE=10000
FW_ACCOUNT_CURRENCY=EUR
FW_RISK_PERCENT=1.0
