# ── Wirtschaftskalender-Prognose: Konfiguration ────────────────────────────────
# Alle Werte sind optional. Ohne Keys laeuft die App mit dem Demo-Kalender
# und den frei zugaenglichen RSS-Nachrichtenquellen.

# Kalender-Provider: demo | tradingeconomics | fmp
EKP_CALENDAR_PROVIDER=demo

# Trading Economics (kostenloser Gast-Key: "guest:guest")
EKP_TE_KEY=guest:guest

# Financial Modeling Prep (https://site.financialmodelingprep.com)
EKP_FMP_KEY=

# Nachrichten: rss (Default, keine Keys noetig) | newsapi
EKP_NEWS_PROVIDER=rss
EKP_NEWSAPI_KEY=

# Analysefenster
EKP_LOOKAHEAD_HOURS=72       # wie weit der Kalender in die Zukunft gescannt wird
EKP_NEWS_LOOKBACK_HOURS=96   # wie weit Nachrichten zurueck beruecksichtigt werden
EKP_MIN_IMPORTANCE=2         # 1=niedrig, 2=mittel, 3=hoch

# Modellparameter
EKP_CONFIRM_BAND=0.5         # Toleranzband in Sigma, in dem die Prognose als bestaetigt gilt
EKP_EVIDENCE_SCALE=3.0       # Daempfung der Nachrichten-Evidenz (groesser = konservativer)

# Speicherort der Datenbank
EKP_DB=data/ekp.sqlite3
