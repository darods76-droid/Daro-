# ---------------------------------------------------------------------------
# ForexWatch – Konfiguration
# Kopiere diese Datei nach .env. Alle Werte sind optional.
# ---------------------------------------------------------------------------

# --- Kursdaten -------------------------------------------------------------
# auto      = Capital.com nehmen, sobald die Zugangsdaten unten stehen,
#             sonst Yahoo (empfohlen)
# capital   = Capital.com erzwingen
# yahoo     = Yahoo Finance, ohne Schluessel nutzbar
# synthetic = erfundene Kurse fuer den Offline-Betrieb
FW_PROVIDER=auto

# --- Capital.com -----------------------------------------------------------
# Den Schluessel findest du im Konto unter Einstellungen -> API-Schluessel.
# Als Kennwort gilt das dort vergebene API-Passwort, nicht dein Login-Passwort.
FW_CAPITAL_API_KEY=
FW_CAPITAL_IDENTIFIER=
FW_CAPITAL_PASSWORD=
# 1 = Demokonto (empfohlen zum Ausprobieren), 0 = Echtgeldkonto
FW_CAPITAL_DEMO=1

# --- Beobachtete Paare -----------------------------------------------------
FW_PAIRS=EURUSD,GBPUSD,USDJPY,USDCHF,AUDUSD,USDCAD,NZDUSD,EURJPY,EURGBP,GBPJPY

# Zeitfenster. Das erste ist das, auf dem Ein- und Ausstiege berechnet werden.
FW_TIMEFRAMES=15m,1h,4h,1d

# Sekunden zwischen zwei Pruefungen
FW_SCAN_INTERVAL=60

# Ab diesem Wert gilt ein Paar als "unter hoher Spannung"
FW_ARM_THRESHOLD=62

# --- Server ----------------------------------------------------------------
FW_HOST=127.0.0.1
FW_PORT=8000

# --- Meldungen (optional) --------------------------------------------------
FW_WEBHOOK_URL=
FW_TELEGRAM_TOKEN=
FW_TELEGRAM_CHAT_ID=

# --- Dein Konto (fuer die Positionsgroesse) --------------------------------
FW_ACCOUNT_BALANCE=10000
FW_ACCOUNT_CURRENCY=EUR
FW_RISK_PERCENT=1.0

# --- Anderer Anbieter (optional) -------------------------------------------
FW_TWELVEDATA_KEY=
